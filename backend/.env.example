# ---- Application ----
ENVIRONMENT=development
DEBUG=true

# ---- Database ----
DATABASE_URL=postgresql+psycopg://bantay:bantay@localhost:5432/bantay
DB_ECHO=false
DB_AUTO_CREATE=false

# ---- Recognition ----
# auto | insightface | null
#   auto        use InsightFace if installed, otherwise run without recognition
#   insightface require InsightFace (fail loudly if missing)
#   null        never recognize (API and dashboard still work)
RECOGNITION_ENGINE=auto
INSIGHTFACE_MODEL=buffalo_l
# -1 = CPU, 0 = first GPU
INSIGHTFACE_CTX_ID=-1
EMBEDDING_DIM=512
# ADAPTER_PATH=./models/lab_adapter.onnx

# ---- Entry rules ----
DEFAULT_MATCH_THRESHOLD=0.45
DEFAULT_COOLDOWN_SECONDS=120
MIN_ENROLLMENT_PHOTOS=3
MAX_ENROLLMENT_PHOTOS=5

# ---- Cameras ----
CAMERA_WORKERS_ENABLED=true
CAMERA_SAMPLE_FPS=10
STREAM_FPS=10

# ---- Media ----
MEDIA_ROOT=./media
